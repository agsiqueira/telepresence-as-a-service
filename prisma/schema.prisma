generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  OPERATOR
  VIEWER
}

enum AccountStatus {
  ACTIVE
  DEACTIVATED
}

enum AccountLifecycleAction {
  DEACTIVATE
  REACTIVATE
}

enum OperatorPilotStatus {
  PENDING
  APPROVED
  SUSPENDED
}

enum AdminRoleChangeAction {
  ASSIGN_OPERATOR
  RETURN_TO_VIEWER
  ASSIGN_ADMIN
  REMOVE_ADMIN
}

enum OperatorApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

enum TripStatus {
  REQUESTED
  OFFERED
  ACCEPTED
  IN_PROGRESS
  ENDED
  FEEDBACK_COMPLETED
  CANCELLED
  NO_OPERATOR_AVAILABLE
}

enum OfferStatus {
  OFFERED
  ACCEPTED
  DECLINED
  EXPIRED
}

enum JourneyRequestStatus {
  OPEN
  WITHDRAWN
  EXPIRED
  CONVERTED
}

enum ProposalStatus {
  ACTIVE
  SUPERSEDED
  WITHDRAWN
  DECLINED
  EXPIRED
  ACCEPTED
  NOT_SELECTED
}

enum AgreementStatus {
  CONFIRMED
}

enum ScheduledJourneyReservationStatus {
  CONFIRMED
  RELEASED
}

enum ScheduledJourneyRescheduleStatus {
  PENDING
  ACCEPTED
  DECLINED
  WITHDRAWN
  SUPERSEDED
}

enum JourneyReviewRole {
  EXPLORER
  TELEPORTER
}

enum SafetyReportCategory {
  HARASSMENT
  DISCRIMINATION
  THREATENING_BEHAVIOR
  UNSAFE_CONDUCT
  PROPERTY_OR_PRIVACY_CONCERN
  OTHER
}

enum SafetyReportSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum SafetyReportRole {
  EXPLORER
  TELEPORTER
}

enum SafetyReportTriageStatus {
  NEW
  UNDER_REVIEW
  ESCALATED
  CLOSED_NO_ACTION
}

enum SafetyReportConversationRole {
  REPORTER
  REPORTED_PARTICIPANT
}

enum SafetyReportMessageAuthorType {
  ADMINISTRATOR
  PARTICIPANT
}

enum SafetyRestrictionParticipantRole {
  REPORTER
  REPORTED_PARTICIPANT
}

enum SafetyRestrictionStatus {
  PROPOSED
  ACTIVE
  REJECTED
  REVERSED
  EXPIRED
}

enum SafetyRestrictionDuration {
  HOURS_24
  DAYS_7
  DAYS_30
}

enum SafetyRestrictionEventType {
  PROPOSED
  APPROVED_AND_ACTIVATED
  REJECTED
  REVERSED
  EXPIRED
}

enum SupplyType {
  LIVE_MOMENT
  GUIDED_EXPERIENCE
}

enum SupplyStatus {
  DRAFT
  PUBLISHED
  PAUSED
  ARCHIVED
}

enum SupplyCapacityClaimStatus {
  HELD
  COMMITTED
  RELEASED
  EXPIRED
}

model User {
  id                       String        @id @default(cuid())
  clerkId                  String        @unique
  name                     String?
  preferredLanguage        String?
  accessibilityPreferences String[]      @default([])
  role                     Role          @default(VIEWER)
  accountStatus            AccountStatus @default(ACTIVE)
  deactivatedAt            DateTime?
  online                   Boolean       @default(false) // operator's "go online" toggle
  // Internal marketplace reservations claimed inside serializable transactions.
  pendingOfferTripId       String?
  activeTripId             String?
  createdAt                DateTime      @default(now())

  tripsAsViewer                   Trip[]                               @relation("TripsAsViewer")
  tripsAsOperator                 Trip[]                               @relation("TripsAsOperator")
  feedback                        Feedback[]
  operatorProfile                 OperatorProfile?
  destinationServices             OperatorDestination[]
  offers                          TripOffer[]                          @relation("OperatorOffers")
  offeredTrips                    Trip[]                               @relation("OfferedOperator")
  roleChangesPerformed            AdminRoleChangeAudit[]               @relation("AdminRoleChangeActor")
  roleChangesReceived             AdminRoleChangeAudit[]               @relation("AdminRoleChangeTarget")
  operatorApplications            OperatorApplication[]                @relation("OperatorApplicationApplicant")
  applicationsReviewed            OperatorApplication[]                @relation("OperatorApplicationReviewer")
  accountLifecycleActions         AccountLifecycleAudit[]              @relation("AccountLifecycleActor")
  accountLifecycleHistory         AccountLifecycleAudit[]              @relation("AccountLifecycleTarget")
  journeyRequests                 JourneyRequest[]                     @relation("ExplorerJourneyRequests")
  proposalsAuthored               Proposal[]                           @relation("TeleporterProposals")
  agreementsAsExplorer            Agreement[]                          @relation("ExplorerAgreements")
  agreementsAsTeleporter          Agreement[]                          @relation("TeleporterAgreements")
  scheduledReservations           ScheduledJourneyReservation[]
  proposedReschedules             ScheduledJourneyRescheduleProposal[]
  journeyReviewsAuthored          JourneyReview[]                      @relation("JourneyReviewsAuthored")
  journeyReviewsReceived          JourneyReview[]                      @relation("JourneyReviewsReceived")
  simulatedTipsGiven              SimulatedTip[]                       @relation("SimulatedTipsGiven")
  simulatedTipsReceived           SimulatedTip[]                       @relation("SimulatedTipsReceived")
  supplyListings                  SupplyListing[]
  supplyCapacityClaims            SupplyCapacityClaim[]                @relation("SupplyClaimsByExplorer")
  safetyReportsAuthored           SafetyReport[]                       @relation("SafetyReportsAuthored")
  safetyReportsReceived           SafetyReport[]                       @relation("SafetyReportsReceived")
  safetyReportTriageEvents        SafetyReportTriageEvent[]            @relation("SafetyReportTriageAdministrators")
  safetyReportsAssigned           SafetyReport[]                       @relation("SafetyReportAssignedAdministrator")
  safetyReportAssignmentActions   SafetyReportAssignmentEvent[]        @relation("SafetyReportAssignmentActors")
  safetyReportPreviousAssignments SafetyReportAssignmentEvent[]        @relation("SafetyReportPreviousAssignee")
  safetyReportNewAssignments      SafetyReportAssignmentEvent[]        @relation("SafetyReportNewAssignee")
  safetyReportInternalNotes       SafetyReportInternalNote[]           @relation("SafetyReportNoteAuthors")
  safetyReportConversations       SafetyReportConversation[]
  safetyReportAdminMessages       SafetyReportMessage[]                @relation("SafetyReportMessageAdministrators")
  safetyReportParticipantMessages SafetyReportMessage[]                @relation("SafetyReportMessageParticipants")
  safetyRestrictionsAffected      SafetyReportRestriction[]            @relation("SafetyRestrictionParticipant")
  safetyRestrictionsProposed      SafetyReportRestriction[]            @relation("SafetyRestrictionProposer")
  safetyRestrictionsApproved      SafetyReportRestriction[]            @relation("SafetyRestrictionApprover")
  safetyRestrictionsRejected      SafetyReportRestriction[]            @relation("SafetyRestrictionRejector")
  safetyRestrictionsReversed      SafetyReportRestriction[]            @relation("SafetyRestrictionReverser")
  safetyRestrictionEvents         SafetyReportRestrictionEvent[]       @relation("SafetyRestrictionEventActor")

  @@index([pendingOfferTripId])
  @@index([activeTripId])
  @@index([accountStatus, role])
}

model AccountLifecycleAudit {
  id             String                 @id @default(cuid())
  actor          User                   @relation("AccountLifecycleActor", fields: [actorId], references: [id], onDelete: Restrict)
  actorId        String
  target         User                   @relation("AccountLifecycleTarget", fields: [targetId], references: [id], onDelete: Restrict)
  targetId       String
  action         AccountLifecycleAction
  previousStatus AccountStatus
  newStatus      AccountStatus
  reason         String
  createdAt      DateTime               @default(now())

  @@index([targetId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

model OperatorApplication {
  id                 String                    @id @default(cuid())
  applicant          User                      @relation("OperatorApplicationApplicant", fields: [applicantId], references: [id], onDelete: Restrict)
  applicantId        String
  qualifications     String
  relevantExperience String
  languages          String[]
  availability       String
  supportingUrl      String?
  additionalNote     String?
  status             OperatorApplicationStatus @default(PENDING)
  reviewer           User?                     @relation("OperatorApplicationReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  reviewedById       String?
  reviewNote         String?
  submittedAt        DateTime                  @default(now())
  reviewedAt         DateTime?
  withdrawnAt        DateTime?
  updatedAt          DateTime                  @updatedAt

  @@index([applicantId, submittedAt])
  @@index([status, submittedAt])
  @@index([reviewedById, reviewedAt])
}

model AdminRoleChangeAudit {
  id           String                @id @default(cuid())
  actor        User                  @relation("AdminRoleChangeActor", fields: [actorId], references: [id], onDelete: Restrict)
  actorId      String
  target       User                  @relation("AdminRoleChangeTarget", fields: [targetId], references: [id], onDelete: Restrict)
  targetId     String
  action       AdminRoleChangeAction
  previousRole Role
  newRole      Role
  reason       String?
  createdAt    DateTime              @default(now())

  @@index([targetId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

model Destination {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  shortDescription String
  city             String
  meetingArea      String
  category         String
  durationOptions  Int[]
  active           Boolean  @default(true)
  imageUrl         String?
  custom           Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  trips           Trip[]
  operators       OperatorDestination[]
  journeyRequests JourneyRequest[]

  @@index([active, category])
}

model OperatorProfile {
  id                        String              @id @default(cuid())
  user                      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                    String              @unique
  operatingArea             String
  serviceRadiusKm           Float
  supportsCustom            Boolean             @default(false)
  languages                 String[]
  accessibilityCapabilities String[]
  durationOptions           Int[]
  pilotStatus               OperatorPilotStatus @default(PENDING)
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt
}

model OperatorDestination {
  operator      User        @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  operatorId    String
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  destinationId String

  @@id([operatorId, destinationId])
  @@index([destinationId])
}

model Trip {
  id                    String       @id @default(cuid())
  viewer                User         @relation("TripsAsViewer", fields: [viewerId], references: [id])
  viewerId              String
  operator              User?        @relation("TripsAsOperator", fields: [operatorId], references: [id])
  operatorId            String?
  offeredOperator       User?        @relation("OfferedOperator", fields: [offeredOperatorId], references: [id])
  offeredOperatorId     String?
  destinationRef        Destination? @relation(fields: [destinationId], references: [id])
  destinationId         String?
  destination           String
  operatingArea         String?
  meetingArea           String?
  requestedDuration     Int?
  viewerNote            String?
  preferredLanguage     String?
  accessibilityNeeds    String[]     @default([])
  customDestination     String?
  immediate             Boolean      @default(true)
  offerExpiresAt        DateTime?
  lat                   Float?
  lng                   Float?
  livekitRoom           String       @unique
  status                TripStatus   @default(REQUESTED)
  requestedAt           DateTime     @default(now())
  offeredAt             DateTime?
  acceptedAt            DateTime?
  startedAt             DateTime?
  endedAt               DateTime?
  cancelledAt           DateTime?
  cancelledBy           Role?
  noOperatorAvailableAt DateTime?
  feedbackCompletedAt   DateTime?
  feedbackSkippedAt     DateTime?
  reviewDeadlineAt      DateTime?    @db.Timestamptz(3)
  retryOfTripId         String?      @unique

  feedback                  Feedback[]
  offers                    TripOffer[]
  journeyRequest            JourneyRequest?
  agreement                 Agreement?
  scheduledReservations     ScheduledJourneyReservation[]
  rescheduleProposals       ScheduledJourneyRescheduleProposal[]
  reviews                   JourneyReview[]
  simulatedTip              SimulatedTip?
  supplyCapacityClaim       SupplyCapacityClaim?
  supplyCapacityRestoration SupplyCapacityRestoration?
  safetyReports             SafetyReport[]

  @@unique([id, viewerId, operatorId])
  @@index([status])
  @@index([offeredOperatorId, status, offerExpiresAt])
  @@index([destinationId])
}

model JourneyRequest {
  id                    String                      @id @default(cuid())
  explorer              User                        @relation("ExplorerJourneyRequests", fields: [explorerId], references: [id], onDelete: Restrict)
  explorerId            String
  destination           Destination?                @relation(fields: [destinationId], references: [id], onDelete: SetNull)
  destinationId         String?
  trip                  Trip?                       @relation(fields: [tripId], references: [id], onDelete: Restrict)
  tripId                String?                     @unique
  publicPlaceName       String                      @db.VarChar(120)
  coarseLocation        String                      @db.VarChar(120)
  privateMeetingDetails String?                     @db.VarChar(500)
  earliestStart         DateTime
  latestStart           DateTime
  durationMinutes       Int
  proposedPriceMinor    Int
  currency              String                      @db.Char(3)
  expiresAt             DateTime
  status                JourneyRequestStatus        @default(OPEN)
  withdrawnAt           DateTime?
  convertedAt           DateTime?
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
  proposals             Proposal[]
  agreement             Agreement?
  supplyCapacityClaim   SupplyCapacityClaim?
  supplyListing         SupplyListing?              @relation("SupplyJourneyRequests", fields: [supplyListingId], references: [id], onDelete: Restrict)
  supplyListingId       String?                     @db.Uuid
  supplyListingVersion  Int?
  supplyOccurrence      GuidedExperienceOccurrence? @relation("SupplyJourneyRequestOccurrences", fields: [supplyOccurrenceId], references: [id], onDelete: Restrict)
  supplyOccurrenceId    String?                     @db.Uuid

  @@unique([id, explorerId])
  @@index([explorerId, createdAt])
  @@index([status, expiresAt, earliestStart])
  @@index([coarseLocation, status, expiresAt])
  @@index([destinationId])
  @@index([supplyListingId, supplyListingVersion])
  @@index([supplyOccurrenceId])
}

model Proposal {
  id                   String                      @id @default(cuid())
  journeyRequest       JourneyRequest              @relation(fields: [journeyRequestId], references: [id], onDelete: Restrict)
  journeyRequestId     String
  teleporter           User                        @relation("TeleporterProposals", fields: [teleporterId], references: [id], onDelete: Restrict)
  teleporterId         String
  version              Int
  revisesProposal      Proposal?                   @relation("ProposalRevision", fields: [revisesProposalId], references: [id], onDelete: Restrict)
  revisesProposalId    String?                     @unique
  revision             Proposal?                   @relation("ProposalRevision")
  earliestStart        DateTime
  latestStart          DateTime?
  durationMinutes      Int
  proposedPriceMinor   Int
  currency             String                      @db.Char(3)
  validUntil           DateTime
  status               ProposalStatus              @default(ACTIVE)
  createdAt            DateTime                    @default(now())
  terminalAt           DateTime?
  agreement            Agreement?
  supplyCapacityClaim  SupplyCapacityClaim?
  supplyListing        SupplyListing?              @relation("SupplyProposals", fields: [supplyListingId], references: [id], onDelete: Restrict)
  supplyListingId      String?                     @db.Uuid
  supplyListingVersion Int?
  supplyOccurrence     GuidedExperienceOccurrence? @relation("SupplyProposalOccurrences", fields: [supplyOccurrenceId], references: [id], onDelete: Restrict)
  supplyOccurrenceId   String?                     @db.Uuid

  @@unique([id, journeyRequestId, teleporterId])
  @@unique([journeyRequestId, teleporterId, version])
  @@index([journeyRequestId, status, validUntil])
  @@index([teleporterId, journeyRequestId, createdAt])
  @@index([supplyListingId, supplyListingVersion])
  @@index([supplyOccurrenceId])
}

model Agreement {
  id                      String                               @id @default(cuid())
  journeyRequest          JourneyRequest                       @relation(fields: [journeyRequestId, explorerId], references: [id, explorerId], onDelete: Restrict)
  journeyRequestId        String                               @unique
  proposal                Proposal                             @relation(fields: [proposalId, journeyRequestId, teleporterId], references: [id, journeyRequestId, teleporterId], onDelete: Restrict)
  proposalId              String                               @unique
  explorer                User                                 @relation("ExplorerAgreements", fields: [explorerId], references: [id], onDelete: Restrict)
  explorerId              String
  teleporter              User                                 @relation("TeleporterAgreements", fields: [teleporterId], references: [id], onDelete: Restrict)
  teleporterId            String
  trip                    Trip                                 @relation(fields: [tripId, explorerId, teleporterId], references: [id, viewerId, operatorId], onDelete: Restrict)
  tripId                  String                               @unique
  agreedStartAt           DateTime?                            @db.Timestamptz(3)
  agreedEarliestStart     DateTime
  agreedLatestStart       DateTime?
  agreedDurationMinutes   Int
  agreedPriceMinor        Int
  currency                String                               @db.Char(3)
  destinationIdSnapshot   String?
  publicPlaceNameSnapshot String                               @db.VarChar(120)
  coarseLocationSnapshot  String                               @db.VarChar(120)
  privateMeetingSnapshot  String?                              @db.VarChar(500)
  status                  AgreementStatus                      @default(CONFIRMED)
  confirmedAt             DateTime                             @default(now())
  scheduledReservations   ScheduledJourneyReservation[]
  rescheduleProposals     ScheduledJourneyRescheduleProposal[]
  supplyCapacityClaim     SupplyCapacityClaim?

  @@unique([journeyRequestId, explorerId])
  @@unique([proposalId, journeyRequestId, teleporterId])
  @@unique([tripId, explorerId, teleporterId])
  @@index([explorerId, confirmedAt])
  @@index([teleporterId, confirmedAt])
}

model ScheduledJourneyReservation {
  id                       String                               @id @default(uuid()) @db.Uuid
  teleporter               User                                 @relation(fields: [teleporterId], references: [id], onDelete: Restrict)
  teleporterId             String
  agreement                Agreement                            @relation(fields: [agreementId], references: [id], onDelete: Restrict)
  agreementId              String
  trip                     Trip                                 @relation(fields: [tripId], references: [id], onDelete: Restrict)
  tripId                   String
  startAt                  DateTime                             @db.Timestamptz(3)
  endAt                    DateTime                             @db.Timestamptz(3)
  status                   ScheduledJourneyReservationStatus    @default(CONFIRMED)
  createdAt                DateTime                             @default(now()) @db.Timestamptz(3)
  releasedAt               DateTime?                            @db.Timestamptz(3)
  sourceForReschedules     ScheduledJourneyRescheduleProposal[] @relation("RescheduleSourceReservation")
  replacementForReschedule ScheduledJourneyRescheduleProposal?  @relation("RescheduleReplacementReservation")

  @@index([teleporterId, startAt])
  @@index([status, startAt])
  @@index([agreementId, status])
  @@index([tripId, status])
}

model ScheduledJourneyRescheduleProposal {
  id                       String                           @id @default(uuid()) @db.Uuid
  agreement                Agreement                        @relation(fields: [agreementId], references: [id], onDelete: Restrict)
  agreementId              String
  trip                     Trip                             @relation(fields: [tripId], references: [id], onDelete: Restrict)
  tripId                   String
  proposer                 User                             @relation(fields: [proposerId], references: [id], onDelete: Restrict)
  proposerId               String
  fromReservation          ScheduledJourneyReservation      @relation("RescheduleSourceReservation", fields: [fromReservationId], references: [id], onDelete: Restrict)
  fromReservationId        String                           @db.Uuid
  replacementReservation   ScheduledJourneyReservation?     @relation("RescheduleReplacementReservation", fields: [replacementReservationId], references: [id], onDelete: Restrict)
  replacementReservationId String?                          @unique @db.Uuid
  proposedStartAt          DateTime                         @db.Timestamptz(3)
  proposedEndAt            DateTime                         @db.Timestamptz(3)
  status                   ScheduledJourneyRescheduleStatus @default(PENDING)
  createdAt                DateTime                         @default(now()) @db.Timestamptz(3)
  resolvedAt               DateTime?                        @db.Timestamptz(3)

  @@index([agreementId, createdAt])
  @@index([tripId, status])
  @@index([proposerId, createdAt])
}

model TripOffer {
  id          String      @id @default(cuid())
  trip        Trip        @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripId      String
  operator    User        @relation("OperatorOffers", fields: [operatorId], references: [id], onDelete: Cascade)
  operatorId  String
  status      OfferStatus @default(OFFERED)
  expiresAt   DateTime
  createdAt   DateTime    @default(now())
  respondedAt DateTime?

  @@unique([tripId, operatorId])
  @@index([operatorId, status, expiresAt])
}

model Feedback {
  id           String   @id @default(cuid())
  trip         Trip     @relation(fields: [tripId], references: [id])
  tripId       String   @unique
  viewer       User     @relation(fields: [viewerId], references: [id])
  viewerId     String
  presence     Int // 1-5, "I felt like I was really there"
  mediaQuality Int // 1-5, "The video was clear enough to see details"
  moodBefore   Int? // 0-10 VAS
  moodAfter    Int? // 0-10 VAS
  createdAt    DateTime @default(now())
}

model JourneyReview {
  id           String            @id @default(uuid()) @db.Uuid
  trip         Trip              @relation(fields: [tripId], references: [id], onDelete: Restrict)
  tripId       String
  reviewer     User              @relation("JourneyReviewsAuthored", fields: [reviewerId], references: [id], onDelete: Restrict)
  reviewerId   String
  reviewee     User              @relation("JourneyReviewsReceived", fields: [revieweeId], references: [id], onDelete: Restrict)
  revieweeId   String
  reviewerRole JourneyReviewRole
  revieweeRole JourneyReviewRole
  rating       Int
  comment      String?           @db.VarChar(1000)
  submittedAt  DateTime          @default(now()) @db.Timestamptz(3)

  @@unique([tripId, reviewerId])
  @@unique([tripId, reviewerRole])
  @@index([revieweeId, revieweeRole, submittedAt])
  @@index([tripId, submittedAt])
}

model SimulatedTip {
  id           String   @id @default(uuid()) @db.Uuid
  trip         Trip     @relation(fields: [tripId, explorerId, teleporterId], references: [id, viewerId, operatorId], onDelete: Restrict)
  tripId       String   @unique
  explorer     User     @relation("SimulatedTipsGiven", fields: [explorerId], references: [id], onDelete: Restrict)
  explorerId   String
  teleporter   User     @relation("SimulatedTipsReceived", fields: [teleporterId], references: [id], onDelete: Restrict)
  teleporterId String
  amountMinor  Int
  currency     String   @db.Char(3)
  submittedAt  DateTime @default(now()) @db.Timestamptz(3)

  @@unique([tripId, explorerId, teleporterId])
  @@index([explorerId, submittedAt])
  @@index([teleporterId, submittedAt])
}

model SupplyListing {
  id                    String                      @id @default(uuid()) @db.Uuid
  teleporter            User                        @relation(fields: [teleporterId], references: [id], onDelete: Restrict)
  teleporterId          String
  type                  SupplyType
  status                SupplyStatus                @default(DRAFT)
  publicPlaceName       String                      @db.VarChar(120)
  coarseLocation        String                      @db.VarChar(120)
  durationMinutes       Int
  priceMinor            Int
  currency              String                      @db.Char(3)
  capacity              Int
  version               Int                         @default(1)
  createdAt             DateTime                    @default(now()) @db.Timestamptz(3)
  publishedAt           DateTime?                   @db.Timestamptz(3)
  pausedAt              DateTime?                   @db.Timestamptz(3)
  archivedAt            DateTime?                   @db.Timestamptz(3)
  liveMoment            LiveMoment?
  guidedExperience      GuidedExperience?
  claims                SupplyCapacityClaim[]
  capacityRestorations  SupplyCapacityRestoration[]
  sourceJourneyRequests JourneyRequest[]            @relation("SupplyJourneyRequests")
  sourceProposals       Proposal[]                  @relation("SupplyProposals")

  @@unique([id, teleporterId])
  @@index([teleporterId, status, createdAt])
  @@index([type, status, publishedAt])
}

model LiveMoment {
  id                   String                      @id @default(uuid()) @db.Uuid
  listing              SupplyListing               @relation(fields: [listingId], references: [id], onDelete: Restrict)
  listingId            String                      @unique @db.Uuid
  availabilityStart    DateTime                    @db.Timestamptz(3)
  availabilityEnd      DateTime                    @db.Timestamptz(3)
  expiresAt            DateTime                    @db.Timestamptz(3)
  claims               SupplyCapacityClaim[]
  capacityRestorations SupplyCapacityRestoration[]

  @@index([availabilityStart, availabilityEnd])
  @@index([expiresAt])
}

model GuidedExperience {
  id          String                       @id @default(uuid()) @db.Uuid
  listing     SupplyListing                @relation(fields: [listingId], references: [id], onDelete: Restrict)
  listingId   String                       @unique @db.Uuid
  title       String                       @db.VarChar(120)
  description String                       @db.VarChar(2000)
  occurrences GuidedExperienceOccurrence[]
}

model GuidedExperienceOccurrence {
  id                      String                      @id @default(uuid()) @db.Uuid
  guidedExperience        GuidedExperience            @relation(fields: [guidedExperienceId], references: [id], onDelete: Restrict)
  guidedExperienceId      String                      @db.Uuid
  status                  SupplyStatus                @default(DRAFT)
  availabilityStart       DateTime                    @db.Timestamptz(3)
  availabilityEnd         DateTime                    @db.Timestamptz(3)
  capacity                Int
  createdAt               DateTime                    @default(now()) @db.Timestamptz(3)
  publishedAt             DateTime?                   @db.Timestamptz(3)
  pausedAt                DateTime?                   @db.Timestamptz(3)
  archivedAt              DateTime?                   @db.Timestamptz(3)
  supplyListingVersion    Int?
  titleSnapshot           String?                     @db.VarChar(120)
  descriptionSnapshot     String?                     @db.VarChar(2000)
  publicPlaceSnapshot     String?                     @db.VarChar(120)
  coarseLocationSnapshot  String?                     @db.VarChar(120)
  durationMinutesSnapshot Int?
  priceMinorSnapshot      Int?
  currencySnapshot        String?                     @db.Char(3)
  replacesOccurrence      GuidedExperienceOccurrence? @relation("GuidedOccurrenceReplacement", fields: [replacesOccurrenceId], references: [id], onDelete: Restrict)
  replacesOccurrenceId    String?                     @unique @db.Uuid
  replacement             GuidedExperienceOccurrence? @relation("GuidedOccurrenceReplacement")
  claims                  SupplyCapacityClaim[]
  capacityRestorations    SupplyCapacityRestoration[]
  sourceJourneyRequests   JourneyRequest[]            @relation("SupplyJourneyRequestOccurrences")
  sourceProposals         Proposal[]                  @relation("SupplyProposalOccurrences")

  @@unique([guidedExperienceId, availabilityStart])
  @@index([guidedExperienceId, status, availabilityStart])
  @@index([status, availabilityStart, availabilityEnd])
}

model SupplyCapacityClaim {
  id               String                      @id @default(uuid()) @db.Uuid
  listing          SupplyListing               @relation(fields: [listingId, teleporterId], references: [id, teleporterId], onDelete: Restrict)
  listingId        String                      @db.Uuid
  liveMoment       LiveMoment?                 @relation(fields: [liveMomentId], references: [id], onDelete: Restrict)
  liveMomentId     String?                     @db.Uuid
  occurrence       GuidedExperienceOccurrence? @relation(fields: [occurrenceId], references: [id], onDelete: Restrict)
  occurrenceId     String?                     @db.Uuid
  explorer         User                        @relation("SupplyClaimsByExplorer", fields: [explorerId], references: [id], onDelete: Restrict)
  explorerId       String
  teleporterId     String
  startAt          DateTime                    @db.Timestamptz(3)
  endAt            DateTime                    @db.Timestamptz(3)
  status           SupplyCapacityClaimStatus   @default(HELD)
  createdAt        DateTime                    @default(now()) @db.Timestamptz(3)
  expiresAt        DateTime                    @db.Timestamptz(3)
  releasedAt       DateTime?                   @db.Timestamptz(3)
  committedAt      DateTime?                   @db.Timestamptz(3)
  journeyRequest   JourneyRequest?             @relation(fields: [journeyRequestId], references: [id], onDelete: Restrict)
  journeyRequestId String?                     @unique
  proposal         Proposal?                   @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  proposalId       String?                     @unique
  agreement        Agreement?                  @relation(fields: [agreementId], references: [id], onDelete: Restrict)
  agreementId      String?                     @unique
  trip             Trip?                       @relation(fields: [tripId], references: [id], onDelete: Restrict)
  tripId           String?                     @unique
  restoration      SupplyCapacityRestoration?

  @@index([explorerId, status, expiresAt])
  @@index([teleporterId, status, startAt, endAt])
  @@index([listingId, status, expiresAt])
  @@index([liveMomentId, status, expiresAt])
  @@index([occurrenceId, status, expiresAt])
}

model SupplyCapacityRestoration {
  id           String                      @id @default(uuid()) @db.Uuid
  claim        SupplyCapacityClaim         @relation(fields: [claimId], references: [id], onDelete: Restrict)
  claimId      String                      @unique @db.Uuid
  trip         Trip                        @relation(fields: [tripId], references: [id], onDelete: Restrict)
  tripId       String                      @unique
  listing      SupplyListing               @relation(fields: [listingId], references: [id], onDelete: Restrict)
  listingId    String                      @db.Uuid
  liveMoment   LiveMoment?                 @relation(fields: [liveMomentId], references: [id], onDelete: Restrict)
  liveMomentId String?                     @db.Uuid
  occurrence   GuidedExperienceOccurrence? @relation(fields: [occurrenceId], references: [id], onDelete: Restrict)
  occurrenceId String?                     @db.Uuid
  startAt      DateTime                    @db.Timestamptz(3)
  endAt        DateTime                    @db.Timestamptz(3)
  createdAt    DateTime                    @default(now()) @db.Timestamptz(3)

  @@index([listingId, startAt, endAt])
  @@index([liveMomentId, startAt, endAt])
}

model SafetyReport {
  id                      String                        @id @default(uuid()) @db.Uuid
  trip                    Trip                          @relation(fields: [tripId], references: [id], onDelete: Restrict)
  tripId                  String
  reporter                User                          @relation("SafetyReportsAuthored", fields: [reporterId], references: [id], onDelete: Restrict)
  reporterId              String
  reported                User                          @relation("SafetyReportsReceived", fields: [reportedId], references: [id], onDelete: Restrict)
  reportedId              String
  reporterRole            SafetyReportRole
  reportedRole            SafetyReportRole
  category                SafetyReportCategory
  severity                SafetyReportSeverity
  narrative               String                        @db.VarChar(2000)
  createdAt               DateTime                      @default(now()) @db.Timestamptz(3)
  triageStatus            SafetyReportTriageStatus      @default(NEW)
  triageEvents            SafetyReportTriageEvent[]
  assignedAdministrator   User?                         @relation("SafetyReportAssignedAdministrator", fields: [assignedAdministratorId], references: [id], onDelete: Restrict)
  assignedAdministratorId String?
  assignedAt              DateTime?                     @db.Timestamptz(3)
  assignmentEvents        SafetyReportAssignmentEvent[]
  internalNotes           SafetyReportInternalNote[]
  conversations           SafetyReportConversation[]
  restrictions            SafetyReportRestriction[]

  @@unique([tripId, reporterId])
  @@index([createdAt, id])
  @@index([reportedId, createdAt])
}

model SafetyReportTriageEvent {
  id              String                   @id @default(uuid()) @db.Uuid
  safetyReport    SafetyReport             @relation(fields: [safetyReportId], references: [id], onDelete: Restrict)
  safetyReportId  String                   @db.Uuid
  administrator   User                     @relation("SafetyReportTriageAdministrators", fields: [administratorId], references: [id], onDelete: Restrict)
  administratorId String
  previousStatus  SafetyReportTriageStatus
  newStatus       SafetyReportTriageStatus
  createdAt       DateTime                 @default(now()) @db.Timestamptz(3)

  @@index([safetyReportId, createdAt, id])
}

model SafetyReportAssignmentEvent {
  id                              String       @id @default(uuid()) @db.Uuid
  safetyReport                    SafetyReport @relation(fields: [safetyReportId], references: [id], onDelete: Restrict)
  safetyReportId                  String       @db.Uuid
  actingAdministrator             User         @relation("SafetyReportAssignmentActors", fields: [actingAdministratorId], references: [id], onDelete: Restrict)
  actingAdministratorId           String
  previousAssignedAdministrator   User?        @relation("SafetyReportPreviousAssignee", fields: [previousAssignedAdministratorId], references: [id], onDelete: Restrict)
  previousAssignedAdministratorId String?
  newAssignedAdministrator        User?        @relation("SafetyReportNewAssignee", fields: [newAssignedAdministratorId], references: [id], onDelete: Restrict)
  newAssignedAdministratorId      String?
  createdAt                       DateTime     @default(now()) @db.Timestamptz(3)

  @@index([safetyReportId, createdAt, id])
}

model SafetyReportInternalNote {
  id              String       @id @default(uuid()) @db.Uuid
  safetyReport    SafetyReport @relation(fields: [safetyReportId], references: [id], onDelete: Restrict)
  safetyReportId  String       @db.Uuid
  administrator   User         @relation("SafetyReportNoteAuthors", fields: [administratorId], references: [id], onDelete: Restrict)
  administratorId String
  body            String       @db.VarChar(2000)
  createdAt       DateTime     @default(now()) @db.Timestamptz(3)

  @@index([safetyReportId, createdAt, id])
}

model SafetyReportConversation {
  id              String                       @id @default(uuid()) @db.Uuid
  safetyReport    SafetyReport                 @relation(fields: [safetyReportId], references: [id], onDelete: Restrict)
  safetyReportId  String                       @db.Uuid
  participantRole SafetyReportConversationRole
  participant     User                         @relation(fields: [participantId], references: [id], onDelete: Restrict)
  participantId   String
  createdAt       DateTime                     @default(now()) @db.Timestamptz(3)
  messages        SafetyReportMessage[]

  @@unique([safetyReportId, participantRole])
  @@index([participantId, createdAt, id])
}

model SafetyReportMessage {
  id              String                        @id @default(uuid()) @db.Uuid
  conversation    SafetyReportConversation      @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  conversationId  String                        @db.Uuid
  authorType      SafetyReportMessageAuthorType
  administrator   User?                         @relation("SafetyReportMessageAdministrators", fields: [administratorId], references: [id], onDelete: Restrict)
  administratorId String?
  participant     User?                         @relation("SafetyReportMessageParticipants", fields: [participantId], references: [id], onDelete: Restrict)
  participantId   String?
  body            String                        @db.VarChar(2000)
  createdAt       DateTime                      @default(now()) @db.Timestamptz(3)

  @@index([conversationId, createdAt, id])
}

model SafetyReportRestriction {
  id                        String                           @id @default(uuid()) @db.Uuid
  safetyReport              SafetyReport                     @relation(fields: [safetyReportId], references: [id], onDelete: Restrict)
  safetyReportId            String                           @db.Uuid
  participantRole           SafetyRestrictionParticipantRole
  participant               User                             @relation("SafetyRestrictionParticipant", fields: [participantId], references: [id], onDelete: Restrict)
  participantId             String
  status                    SafetyRestrictionStatus          @default(PROPOSED)
  duration                  SafetyRestrictionDuration
  internalReason            String                           @db.VarChar(2000)
  participantExplanation    String                           @db.VarChar(1000)
  proposedByAdministrator   User                             @relation("SafetyRestrictionProposer", fields: [proposedByAdministratorId], references: [id], onDelete: Restrict)
  proposedByAdministratorId String
  proposedAt                DateTime                         @default(now()) @db.Timestamptz(3)
  approvedByAdministrator   User?                            @relation("SafetyRestrictionApprover", fields: [approvedByAdministratorId], references: [id], onDelete: Restrict)
  approvedByAdministratorId String?
  approvedAt                DateTime?                        @db.Timestamptz(3)
  startsAt                  DateTime?                        @db.Timestamptz(3)
  expiresAt                 DateTime?                        @db.Timestamptz(3)
  rejectedByAdministrator   User?                            @relation("SafetyRestrictionRejector", fields: [rejectedByAdministratorId], references: [id], onDelete: Restrict)
  rejectedByAdministratorId String?
  rejectedAt                DateTime?                        @db.Timestamptz(3)
  rejectionReason           String?                          @db.VarChar(2000)
  reversedByAdministrator   User?                            @relation("SafetyRestrictionReverser", fields: [reversedByAdministratorId], references: [id], onDelete: Restrict)
  reversedByAdministratorId String?
  reversedAt                DateTime?                        @db.Timestamptz(3)
  reversalReason            String?                          @db.VarChar(2000)
  version                   Int                              @default(1)
  createdAt                 DateTime                         @default(now()) @db.Timestamptz(3)
  updatedAt                 DateTime                         @updatedAt @db.Timestamptz(3)
  events                    SafetyReportRestrictionEvent[]

  @@index([participantId, status, expiresAt])
  @@index([safetyReportId, createdAt, id])
}

model SafetyReportRestrictionEvent {
  id                   String                     @id @default(uuid()) @db.Uuid
  restriction          SafetyReportRestriction    @relation(fields: [restrictionId], references: [id], onDelete: Restrict)
  restrictionId        String                     @db.Uuid
  eventType            SafetyRestrictionEventType
  actorAdministrator   User?                      @relation("SafetyRestrictionEventActor", fields: [actorAdministratorId], references: [id], onDelete: Restrict)
  actorAdministratorId String?
  reason               String?                    @db.VarChar(2000)
  occurredAt           DateTime                   @default(now()) @db.Timestamptz(3)

  @@index([restrictionId, occurredAt, id])
}
