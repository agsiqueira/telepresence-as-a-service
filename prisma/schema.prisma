generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  OPERATOR
  VIEWER
}

enum AccountStatus {
  ACTIVE
  DEACTIVATED
}

enum AccountLifecycleAction {
  DEACTIVATE
  REACTIVATE
}

enum OperatorPilotStatus {
  PENDING
  APPROVED
  SUSPENDED
}

enum AdminRoleChangeAction {
  ASSIGN_OPERATOR
  RETURN_TO_VIEWER
}

enum OperatorApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

enum TripStatus {
  REQUESTED
  OFFERED
  ACCEPTED
  IN_PROGRESS
  ENDED
  FEEDBACK_COMPLETED
  CANCELLED
  NO_OPERATOR_AVAILABLE
}

enum OfferStatus {
  OFFERED
  ACCEPTED
  DECLINED
  EXPIRED
}

model User {
  id                       String        @id @default(cuid())
  clerkId                  String        @unique
  name                     String?
  preferredLanguage        String?
  accessibilityPreferences String[]      @default([])
  role                     Role          @default(VIEWER)
  accountStatus            AccountStatus @default(ACTIVE)
  deactivatedAt            DateTime?
  online                   Boolean       @default(false) // operator's "go online" toggle
  // Internal marketplace reservations claimed inside serializable transactions.
  pendingOfferTripId       String?
  activeTripId             String?
  createdAt                DateTime      @default(now())

  tripsAsViewer           Trip[]                  @relation("TripsAsViewer")
  tripsAsOperator         Trip[]                  @relation("TripsAsOperator")
  feedback                Feedback[]
  operatorProfile         OperatorProfile?
  destinationServices     OperatorDestination[]
  offers                  TripOffer[]             @relation("OperatorOffers")
  offeredTrips            Trip[]                  @relation("OfferedOperator")
  roleChangesPerformed    AdminRoleChangeAudit[]  @relation("AdminRoleChangeActor")
  roleChangesReceived     AdminRoleChangeAudit[]  @relation("AdminRoleChangeTarget")
  operatorApplications    OperatorApplication[]   @relation("OperatorApplicationApplicant")
  applicationsReviewed    OperatorApplication[]   @relation("OperatorApplicationReviewer")
  accountLifecycleActions AccountLifecycleAudit[] @relation("AccountLifecycleActor")
  accountLifecycleHistory AccountLifecycleAudit[] @relation("AccountLifecycleTarget")

  @@index([pendingOfferTripId])
  @@index([activeTripId])
  @@index([accountStatus, role])
}

model AccountLifecycleAudit {
  id             String                 @id @default(cuid())
  actor          User                   @relation("AccountLifecycleActor", fields: [actorId], references: [id], onDelete: Restrict)
  actorId        String
  target         User                   @relation("AccountLifecycleTarget", fields: [targetId], references: [id], onDelete: Restrict)
  targetId       String
  action         AccountLifecycleAction
  previousStatus AccountStatus
  newStatus      AccountStatus
  reason         String
  createdAt      DateTime               @default(now())

  @@index([targetId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

model OperatorApplication {
  id                 String                    @id @default(cuid())
  applicant          User                      @relation("OperatorApplicationApplicant", fields: [applicantId], references: [id], onDelete: Restrict)
  applicantId        String
  qualifications     String
  relevantExperience String
  languages          String[]
  availability       String
  supportingUrl      String?
  additionalNote     String?
  status             OperatorApplicationStatus @default(PENDING)
  reviewer           User?                     @relation("OperatorApplicationReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  reviewedById       String?
  reviewNote         String?
  submittedAt        DateTime                  @default(now())
  reviewedAt         DateTime?
  withdrawnAt        DateTime?
  updatedAt          DateTime                  @updatedAt

  @@index([applicantId, submittedAt])
  @@index([status, submittedAt])
  @@index([reviewedById, reviewedAt])
}

model AdminRoleChangeAudit {
  id           String                @id @default(cuid())
  actor        User                  @relation("AdminRoleChangeActor", fields: [actorId], references: [id], onDelete: Restrict)
  actorId      String
  target       User                  @relation("AdminRoleChangeTarget", fields: [targetId], references: [id], onDelete: Restrict)
  targetId     String
  action       AdminRoleChangeAction
  previousRole Role
  newRole      Role
  createdAt    DateTime              @default(now())

  @@index([targetId, createdAt])
  @@index([actorId, createdAt])
}

model Destination {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  shortDescription String
  city             String
  meetingArea      String
  category         String
  durationOptions  Int[]
  active           Boolean  @default(true)
  imageUrl         String?
  custom           Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  trips     Trip[]
  operators OperatorDestination[]

  @@index([active, category])
}

model OperatorProfile {
  id                        String              @id @default(cuid())
  user                      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                    String              @unique
  operatingArea             String
  serviceRadiusKm           Float
  supportsCustom            Boolean             @default(false)
  languages                 String[]
  accessibilityCapabilities String[]
  durationOptions           Int[]
  pilotStatus               OperatorPilotStatus @default(PENDING)
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt
}

model OperatorDestination {
  operator      User        @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  operatorId    String
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  destinationId String

  @@id([operatorId, destinationId])
  @@index([destinationId])
}

model Trip {
  id                    String       @id @default(cuid())
  viewer                User         @relation("TripsAsViewer", fields: [viewerId], references: [id])
  viewerId              String
  operator              User?        @relation("TripsAsOperator", fields: [operatorId], references: [id])
  operatorId            String?
  offeredOperator       User?        @relation("OfferedOperator", fields: [offeredOperatorId], references: [id])
  offeredOperatorId     String?
  destinationRef        Destination? @relation(fields: [destinationId], references: [id])
  destinationId         String?
  destination           String
  operatingArea         String?
  meetingArea           String?
  requestedDuration     Int?
  viewerNote            String?
  preferredLanguage     String?
  accessibilityNeeds    String[]     @default([])
  customDestination     String?
  immediate             Boolean      @default(true)
  offerExpiresAt        DateTime?
  lat                   Float?
  lng                   Float?
  livekitRoom           String       @unique
  status                TripStatus   @default(REQUESTED)
  requestedAt           DateTime     @default(now())
  offeredAt             DateTime?
  acceptedAt            DateTime?
  startedAt             DateTime?
  endedAt               DateTime?
  cancelledAt           DateTime?
  cancelledBy           Role?
  noOperatorAvailableAt DateTime?
  feedbackCompletedAt   DateTime?
  feedbackSkippedAt     DateTime?
  retryOfTripId         String?      @unique

  feedback Feedback[]
  offers   TripOffer[]

  @@index([status])
  @@index([offeredOperatorId, status, offerExpiresAt])
  @@index([destinationId])
}

model TripOffer {
  id          String      @id @default(cuid())
  trip        Trip        @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripId      String
  operator    User        @relation("OperatorOffers", fields: [operatorId], references: [id], onDelete: Cascade)
  operatorId  String
  status      OfferStatus @default(OFFERED)
  expiresAt   DateTime
  createdAt   DateTime    @default(now())
  respondedAt DateTime?

  @@unique([tripId, operatorId])
  @@index([operatorId, status, expiresAt])
}

model Feedback {
  id           String   @id @default(cuid())
  trip         Trip     @relation(fields: [tripId], references: [id])
  tripId       String   @unique
  viewer       User     @relation(fields: [viewerId], references: [id])
  viewerId     String
  presence     Int // 1-5, "I felt like I was really there"
  mediaQuality Int // 1-5, "The video was clear enough to see details"
  moodBefore   Int? // 0-10 VAS
  moodAfter    Int? // 0-10 VAS
  createdAt    DateTime @default(now())
}
